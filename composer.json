{
	"name": "fundrik/wordpress",
	"description": "WordPress integration for the Fundrik fundraising solution",
	"keywords": [
		"wordpress",
		"php",
		"fundraising",
		"crowdfunding",
		"donations",
		"nonprofit",
		"charity",
		"payment",
		"fundrik"
	],
	"homepage": "https://fundrik.ru",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"authors": [
		{
			"name": "Denis Yanchevskiy",
			"email": "denis@denisco.pro"
		}
	],
	"support": {
		"email": "denis@denisco.pro",
		"issues": "https://github.com/fundrik/wordpress/issues",
		"source": "https://github.com/fundrik/wordpress"
	},
	"require": {
		"php": "^8.3",
		"fundrik/core": "dev-v1.1-dev",
		"fundrik/toolbox": "^1.0",
		"psr/log": "^3.0",
		"monolog/monolog": "^3.12",
		"illuminate/container": "^13.34",
		"yoomoney/yookassa-sdk-php": "^3.15"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"fundrik/coding-standard": "^0.9.0",
		"phpunit/phpunit": "^12.5",
		"brain/monkey": "^2.6",
		"mockery/mockery": "^1.6",
		"phpstan/phpstan": "^2.2",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"swissspidy/phpstan-no-private": "^1.0",
		"spaze/phpstan-disallowed-calls": "^4.14",
		"php-stubs/wordpress-stubs": "^7.1",
		"johnbillion/wp-compat": "^2.0",
		"deptrac/deptrac": "^4.7",
		"infection/infection": "^0.35",
		"rector/rector": "^2.6"
	},
	"autoload": {
		"psr-4": {
			"Fundrik\\WordPress\\": "src/php/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Fundrik\\WordPress\\Tests\\": "tests/unit/",
			"Fundrik\\WordPress\\IntegrationTests\\": "tests/integration/"
		}
	},
	"scripts": {
		"lint": "vendor/bin/phpcs .",
		"lint:fix": "vendor/bin/phpcbf .",
		"test": "vendor/bin/phpunit",
		"test:coverage": "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-html=.tmp/phpunit/report-coverage",
		"phpstan": "vendor/bin/phpstan analyze --memory-limit=2048M",
		"deptrac": "vendor/bin/deptrac analyze --report-uncovered",
		"infection": "vendor/bin/infection"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true,
			"infection/extension-installer": true
		}
	}
}
